# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Provedor do LLM: "gemini" (padrão, tem camada gratuita) ou "openai"
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings rodam localmente (sem chave). Modelo multilíngue que entende português.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Recuperação
TOP_K_CANDIDATES=40
TOP_K_CONTEXT=12
MIN_SIMILARITY=0.905
MIN_EVIDENCES=3

# Se o projeto estiver numa pasta sincronizada (OneDrive), aponte o índice para uma pasta local
# CHROMA_DIR=C:/caminho/local/voc_rag_chroma
